# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-firebase defaults to resolving Firebase through SPM, but
# firebase-ios-sdk's SPM products are automatic libraries rather than dynamic
# ones, so under `use_frameworks! :linkage => :static` each RNFB pod embeds its
# own copy and they collide as duplicate symbols at link time. Falling back to
# CocoaPods for Firebase keeps linkage a project-wide choice instead of one
# Firebase forces on us. Must be set before any target block.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'maulitransporter' do
  config = use_native_modules!

  # Firebase's Swift pods import these two Objective-C pods, and importing an
  # ObjC pod from Swift under static linkage requires a module map, which
  # neither defines by default. Scoped to just these rather than a global
  # `use_modular_headers!`, which would change how every pod in the project
  # compiles — including the RCT-Folly workaround in post_install.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RCT-Folly ships without folly/coro/ headers, so disable coroutine support
    # to prevent "folly/coro/Coroutine.h file not found" errors on C++20 builds.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # CocoaPods may have already set this as a String (e.g. "$(inherited) -DNDEBUG");
        # appending to a String concatenates without a separator and corrupts the last
        # flag into -DNDEBUG-DFOLLY_CFG_NO_COROUTINES=1, which breaks Release builds
        # with "'NDEBUG' macro redefined" + "ISO C99 requires whitespace after the
        # macro name". Always normalise to an Array before adding ours.
        flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        flags = flags.split(' ') if flags.is_a?(String)
        flags << '-DFOLLY_CFG_NO_COROUTINES=1' unless flags.include?('-DFOLLY_CFG_NO_COROUTINES=1')
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags
      end
    end

    # MMKVCore 2.4.0's podspec nests a "RELEASE" => {...} hash inside
    # pod_target_xcconfig, which CocoaPods does not support. It serialises the raw
    # Ruby hash into the generated xcconfig as a setting literally named RELEASE, so
    # clang receives -DRELEASE={"GCC_PREPROCESSOR_DEFINITIONS" and Release builds die
    # with "'NDEBUG' macro redefined" + "ISO C99 requires whitespace after the macro
    # name". Only bites on archive. Strip the line from the generated xcconfigs;
    # NDEBUG=1 is already set by the Release configuration itself, so nothing is lost.
    Dir.glob(File.join(installer.sandbox.target_support_files_root, '**', '*.xcconfig')).each do |path|
      contents = File.read(path)
      cleaned = contents.gsub(/^RELEASE = \{.*\}\n/, '')
      File.write(path, cleaned) unless cleaned == contents
    end
  end
end
