# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Xcode runs script phases with a minimal PATH that does not include nvm, so a
# bare `node` fails. Source nvm and select the project's .nvmrc version (matching
# Android's build.gradle), falling back to whatever `node` is already on PATH.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" --no-use >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi
export NODE_BINARY=$(command -v node)
