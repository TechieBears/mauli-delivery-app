<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location — used as the vehicle location to track the order while a delivery is in progress. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeps location flowing when the app is backgrounded mid-delivery (Android 10+). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service so tracking survives the app being minimised. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Typed foreground-service permission required from Android 14 / targetSdk 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Media — Android 13+ uses granular permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Media — Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Push notifications — Android 13+ requires explicit permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Notifee's foreground service backs the "Delivery in progress" notification.
           targetSdk 34+ requires the service to declare a foregroundServiceType, so we
           override Notifee's default with "location". -->
      <service
        android:name="app.notifee.core.ForegroundService"
        android:foregroundServiceType="location"
        tools:replace="android:foregroundServiceType" />

      <!-- Channel FCM falls back to when a push arrives with the app killed or
           backgrounded and the payload names no channel of its own. Must match
           the channel id created in src/services/pushNotifications.js, or
           Android drops the notification silently on API 26+.
           tools:replace is required because @react-native-firebase/messaging
           declares this same meta-data with an empty value. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="mauli_default"
        tools:replace="android:value" />
    </application>
</manifest>
